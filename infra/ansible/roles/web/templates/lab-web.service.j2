# {{ ansible_managed }}
[Unit]
Description=Lab static HTTP endpoint (Python http.server, learning use only)
After=network.target

[Service]
User=www-data
Group=www-data
ExecStart=/usr/bin/python3 -I -m http.server {{ web_port }} --bind {{ web_bind }} --directory {{ web_root }}
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
