# {{ ansible_managed }}
# Edge-router policy of the QEMU/KVM Infrastructure Lab (iptables-nft backend).
# Interfaces: LAN={{ fw_lan_if }} DMZ={{ fw_dmz_if }} WAN={{ fw_wan_if }}
*filter
{% if edge_input_mode == 'strict' %}
:INPUT DROP [0:0]
{% else %}
:INPUT ACCEPT [0:0]
{% endif %}
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
{% if edge_input_mode == 'strict' %}
# --- Management plane (strict mode): default DROP, SSH only from LAN and management ---
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -p icmp --icmp-type echo-request -m limit --limit 10/second -j ACCEPT
-A INPUT -i {{ lab_mgmt_if }} -s {{ lab_mgmt_cidr }} -p tcp --dport 22 -j ACCEPT
-A INPUT -i {{ fw_lan_if }} -p tcp --dport 22 -m conntrack --ctstate NEW -m recent --name sshrate --set
-A INPUT -i {{ fw_lan_if }} -p tcp --dport 22 -m conntrack --ctstate NEW -m recent --name sshrate --update --seconds 60 --hitcount 10 -j DROP
-A INPUT -i {{ fw_lan_if }} -p tcp --dport 22 -j ACCEPT
{% endif %}
# --- Forwarding policy (matches docs/en/architecture.md) ---
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A FORWARD -i {{ fw_lan_if }} -o {{ fw_wan_if }} -p udp --dport 53 -j ACCEPT
-A FORWARD -i {{ fw_lan_if }} -o {{ fw_wan_if }} -p tcp -m multiport --dports 53,80,443 -j ACCEPT
-A FORWARD -i {{ fw_lan_if }} -o {{ fw_wan_if }} -p icmp --icmp-type echo-request -j ACCEPT
-A FORWARD -i {{ fw_lan_if }} -o {{ fw_dmz_if }} -d 192.168.20.10 -p tcp -m multiport --dports 80,443 -j ACCEPT
-A FORWARD -i {{ fw_wan_if }} -o {{ fw_dmz_if }} -d 192.168.20.10 -p tcp -m multiport --dports 80,443 -j ACCEPT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
# Published DMZ address (WAN ingress only). Port filtering is done in FORWARD.
-A PREROUTING -i {{ fw_wan_if }} -d 198.51.100.10 -j DNAT --to-destination 192.168.20.10
-A POSTROUTING -s 192.168.10.0/24 -o {{ fw_wan_if }} -j MASQUERADE
-A POSTROUTING -s 192.168.20.10 -o {{ fw_wan_if }} -j SNAT --to-source 198.51.100.10
COMMIT
