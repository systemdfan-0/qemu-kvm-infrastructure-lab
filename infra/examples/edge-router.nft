#!/usr/sbin/nft -f
# Native nftables equivalent of the edge-router policy generated by the Ansible role
# edge_firewall with edge_input_mode: strict (iptables-nft). Provided for comparison and
# as a migration target; the documented lab uses iptables-restore. Interface names are
# examples (see the inventory).
#   check without applying:  nft -c -f edge-router.nft
#   apply:                   nft -f edge-router.nft
define lan = "enp2s0"
define dmz = "enp3s0"
define wan = "enp4s0"
define mgmt = "enp1s0"
define web = 192.168.20.10
define published = 198.51.100.10

table inet lab_filter
flush table inet lab_filter

table inet lab_filter {
    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state established,related accept
        ct state invalid drop
        icmp type echo-request limit rate 10/second accept
        iifname $mgmt tcp dport 22 accept
        # SSH from the LAN, at most 10 new connections per minute per source address
        iifname $lan tcp dport 22 ct state new meter ssh_rate { ip saddr limit rate 10/minute } accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        iifname $lan oifname $wan udp dport 53 accept
        iifname $lan oifname $wan tcp dport { 53, 80, 443 } accept
        iifname $lan oifname $wan icmp type echo-request accept
        iifname $lan oifname $dmz ip daddr $web tcp dport { 80, 443 } accept
        iifname $wan oifname $dmz ip daddr $web tcp dport { 80, 443 } accept
    }
}

table ip lab_nat
flush table ip lab_nat

table ip lab_nat {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        iifname $wan ip daddr $published dnat to $web
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname $wan ip saddr 192.168.10.0/24 masquerade
        oifname $wan ip saddr $web snat to $published
    }
}
